APP_NAME="Scheme ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL="₹"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scheme_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:8000

# ---- Accounting defaults (accode of control ledgers) ----
ACC_CASH=1001
ACC_BANK=1002
ACC_SCHEME_DEPOSIT=2001
ACC_GST_PAYABLE=2002
ACC_AGENT_COMMISSION=5001
ACC_SALES=4001
ACC_ROUNDOFF=5099

# ---- Financial year ----
FY_START=04-01
GST_PERCENT=3

# ---- Mobile app (Flutter) ----
MOBILE_APP_NAME="NAFO"
MOBILE_MIN_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_STORE_URL=
MOBILE_SUPPORT_PHONE=
MOBILE_SUPPORT_WHATSAPP=

# ---- OTP login ----
OTP_LENGTH=6
OTP_TTL=300
OTP_RESEND_AFTER=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=6
# Returns the OTP in the API response for testing. Turn OFF in production.
OTP_EXPOSE=true

# ---- SMS driver: log | msg91 | twilio ----
SMS_DRIVER=log
SMS_SENDER=NAFOAP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4
MSG91_COUNTRY=91
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---- Payment gateway (Razorpay) ----
# Leave blank to disable online payment; the app then shows UPI + screenshot upload only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true expects rzp_live_ keys and refuses rzp_test_ ones. Set it to false
# while testing with test keys, or the gateway reports itself as disabled.
RAZORPAY_LIVE_MODE=true
RAZORPAY_CURRENCY=INR
RAZORPAY_THEME="#C9A227"
# Pin the checkout sheet to UPI only. Off by default - hiding every other block
# strands anyone who cannot pay by UPI on their device.
RAZORPAY_UPI_ONLY=false

# ---- Direct UPI (no aggregator) ----
# The app opens Google Pay with a upi://pay link straight to this VPA. No fee,
# money lands in the shop account at once - but nothing can prove it arrived,
# so every such payment waits for the office to approve it against the bank.
# Blank falls back to Settings -> UPI ID, then the first active bank's upi_id.
UPI_DIRECT_ENABLED=true
UPI_VPA=
UPI_PAYEE_NAME=
PAYMENT_AUTO_APPROVE_GATEWAY=true
# Manual UPI shown on the GPay screen (falls back to the banks table when blank)
